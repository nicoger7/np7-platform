{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "np7",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "autoPort": true,
      "port": 3000
    },
    {
      "name": "preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:preview"
      ],
      "port": 3210
    },
    {
      "name": "np7-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3020"
      ],
      "port": 3020
    }
  ]
}
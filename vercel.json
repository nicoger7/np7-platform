{
  "headers": [
    {
      "source": "/cdn/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/emails",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/wind-stats",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/media-retention",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/hours-cost",
      "schedule": "30 3 * * *"
    }
  ]
}